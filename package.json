{
  "name": "susans-calendar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b && tsc -p amplify --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run synth",
    "sandbox": "ampx sandbox",
    "icons": "python3 scripts/make-icons.py",
    "synth": "node scripts/synth.mjs"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.7",
    "@aws-sdk/client-cognito-identity-provider": "3.1156.0",
    "aws-amplify": "^6.22.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "aws-cdk-lib": "^2.274.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@aws-amplify/graphql-docs-generator": {
      "handlebars": "4.7.10"
    },
    "@aws-amplify/graphql-schema-generator": {
      "mysql2": "3.24.6"
    },
    "@ardatan/relay-compiler@12.0.0": {
      "immutable": "3.8.4"
    },
    "lodash@^4.0.0": "4.18.1"
  }
}
